# --- Runtime ---
PORT=3000
NODE_ENV=development
# Public URL of this app (used to build redirects behind a reverse proxy).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: mount this app under a path prefix behind a reverse proxy (e.g. a
# split child served at /coffee). Read by next.config.js at build/boot time
# AND by src/lib/base-path.ts's withBasePath() helper for raw fetch()/<a
# href>/redirect() calls Next.js doesn't auto-prefix. Leave unset to serve at /.
NEXT_PUBLIC_BASE_PATH=

# --- This app's own database ---
# drizzle-orm + postgres (postgres.js), this app's own Postgres schema only.
# Never a kernel database or another app's schema — see docs/MIGRATIONS.md.
DATABASE_URL=postgres://user:password@localhost:5432/imajin_dev
# The Postgres schema this app owns exclusively. Must be a valid lowercase
# snake_case identifier. Set once at registration time and never change it —
# see docs/MIGRATIONS.md.
APP_DB_SCHEMA=market

# --- Imajin kernel (the public app surface this app composes; see AGENTS.md §2) ---
# prod: https://jin.imajin.ai   dev: https://dev-jin.imajin.ai
IMAJIN_AUTH_URL=https://dev-jin.imajin.ai
# Same value, exposed to the browser (Next.js only bundles NEXT_PUBLIC_* vars
# client-side) — used to build the "Sign in with Imajin" redirect.
NEXT_PUBLIC_IMAJIN_AUTH_URL=https://dev-jin.imajin.ai

# --- This app's registration credentials (see docs/REGISTRATION.md) ---
# This app refuses to start without IMAJIN_APP_DID set (see instrumentation.ts).
IMAJIN_APP_DID=did:imajin:REPLACE_ME
# This app's public registry id (`app_...`), returned by registration. Used
# client-side to build the "Sign in with Imajin" redirect — safe to expose.
NEXT_PUBLIC_IMAJIN_APP_ID=

# Optional: a service-level attestation id for kernel API calls made outside
# of any user's session (X-App-Authorization). Leave unset if this app only
# ever acts on behalf of a signed-in user's own session.
IMAJIN_APP_ATTESTATION_ID=

# --- This app's own signing key (#7 — @ima-jin/auth-client's loadAppSigningKey()) ---
# NEVER put a raw private key in this file. This app never reads one from env
# — instrumentation.ts fails loud at boot if IMAJIN_APP_PRIVATE_KEY is set.
# The kernel's own base URL — same value as IMAJIN_AUTH_URL above in practice,
# kept as its own var because loadAppSigningKey() names it this way.
IMAJIN_KERNEL_URL=https://dev-jin.imajin.ai
# One-time claim code from the kernel operator's /jin approval card. Required
# ONLY on first boot (no local keystore yet) — delete it from your .env.local
# once the app has booted successfully once. A lost keystore needs a fresh
# code (ask the operator to re-approve with reissueClaim: true).
IMAJIN_APP_CLAIM_CODE=
# Optional: where the local bootstrap keypair is persisted (mode 0600).
# Defaults to ./.imajin/keystore.json — never the actual signing key, only the
# narrow-purpose keypair that authenticates every boot after the first.
IMAJIN_APP_KEYSTORE=

# --- Session (signed by @ima-jin/auth-client, HS256) ---
SESSION_SECRET=REPLACE_ME
# 32+ random bytes, e.g.: openssl rand -hex 32

# --- Inbound auth: scoped app tokens (see docs/REGISTRATION.md §6) ---
# Every authenticated route goes through src/lib/auth/authenticate.ts, which wraps
# @ima-jin/auth's requireSessionOrAppToken: `Authorization: Bearer <app-token>`
# (audience = the host of NEXT_PUBLIC_APP_URL) or, as a fallback, the shared
# kernel session cookie. The kernel's auth service, WITH its path prefix:
# prod: https://jin.imajin.ai/auth   dev: https://dev-jin.imajin.ai/auth
AUTH_SERVICE_URL=https://dev-jin.imajin.ai/auth

# --- Kernel services this app calls over their public HTTP routes ---
# Checkout sessions (POST {PAY_SERVICE_URL}/api/checkout), with its path prefix.
PAY_SERVICE_URL=https://dev-jin.imajin.ai/pay
# Shared secret the pay service sends with payment webhooks (POST /api/webhook),
# in the x-webhook-secret header or the body. The webhook rejects every request
# while this is unset. 32+ random bytes, e.g.: openssl rand -hex 32
WEBHOOK_SECRET=REPLACE_ME
# Public base URL of the kernel media service, used to turn asset_* image refs
# into CDN URLs (see ima-jin/imajin-ai#2637). Leave empty for relative URLs in dev.
NEXT_PUBLIC_MEDIA_URL=

# --- Hub redirect (middleware.ts) ---
# The standalone /dashboard route 308-redirects to this app's tab in the kernel hub.
# These two build the kernel's public URL (same convention as @ima-jin/config).
NEXT_PUBLIC_SERVICE_PREFIX=dev-
NEXT_PUBLIC_DOMAIN=imajin.ai

# --- Browser-side service URLs (the ported UI pages) ---
# Public URL of the kernel auth service the "enter your email to buy" gate talks
# to (GET /api/session, POST /api/onboard). Same value as AUTH_SERVICE_URL's public form.
NEXT_PUBLIC_AUTH_URL=https://dev-jin.imajin.ai/auth
# This node's DID, shown in the .fair attribution accordion. Optional.
NEXT_PUBLIC_NODE_DID=
# NOTE: image uploads (app/components/ImageUpload.tsx) POST straight to the kernel media
# service with the shared session cookie — the media write routes don't accept scoped
# app tokens yet (ima-jin/imajin-ai#2393). NEXT_PUBLIC_MEDIA_URL above must point at it.
